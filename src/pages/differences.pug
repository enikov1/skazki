                use(href='/assets/icons.svg#arrow-right')
        a.task-card(href='difference-task.html?id=three-pigs', data-story='three-pigs', data-age='5–8 лет')
          img(src='/assets/covers/three-pigs.svg', alt)
          div
            span.task-age 5–8 лет · Про животных
            h2 Найди отличия: «Три поросёнка»
