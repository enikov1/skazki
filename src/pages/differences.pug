extends _layout.pug

include ../includes/site.pug

block title
  title Найди отличия — СказкоМир

block content
  +siteHeader('')
  main.page-wrap
    +siteSearch()
    +breadcrumbs([{label: 'Главная', href: 'index.html'}, {label: 'Занятия', href: 'activities.html'}, {label: 'Найди отличия', href: null}])
    .page-heading-art
      div
        h1.page-title Найди отличия
        p.lead Рассмотрите две картинки и найдите, что в них изменилось.
      img(src='/assets/illustrations/find-differences.svg', alt='Ребёнок с лупой ищет отличия на картинках с лисой')
    section.page-panel.catalog-filters
      .filters
        span.filter-label Возраст
        button.pill.active(data-task-age='Все') Все
        button.pill(data-task-age='3–5 лет') 3–5 лет
        button.pill(data-task-age='5–8 лет') 5–8 лет
        button.pill(data-task-age='9–12 лет') 9–12 лет
      .field
        label(for='taskStory') Сказка
        select#taskStory
          option(value='Все') Все сказки
          option(value='kolobok') Колобок
          option(value='repka') Репка
          option(value='three-pigs') Три поросёнка
          option(value='masha') Маша и медведь
          option(value='sivka') Сивка-Бурка
          option(value='little-red') Красная Шапочка
          option(value='thumbelina') Дюймовочка
          option(value='turnip') Лисичка со скалочкой
          option(value='aybolit') Доктор Айболит
          option(value='moydodyr') Мойдодыр
          option(value='fox-crane') Лиса и журавль
          option(value='cat-house') Кошкин дом
      p.catalog-count Показано 1–6 из 12 заданий
    section.page-panel
      .task-grid
        a.task-card(href='difference-task.html?id=kolobok', data-story='kolobok', data-age='3–5 лет')
          img(src='/assets/covers/kolobok.svg', alt)
          div
            span.task-age 3–5 лет · Народные
            h2 Найди отличия: «Колобок»
            p Найди пять отличий и проверь свою наблюдательность.
            span.task-link
              | Открыть задание 
              svg.icon(aria-hidden='true')
                use(href='/assets/icons.svg#arrow-right')
        a.task-card(href='difference-task.html?id=repka', data-story='repka', data-age='3–5 лет')
          img(src='/assets/covers/repka.svg', alt)
          div
            span.task-age 3–5 лет · Народные
