        a.active(href='?age=%D0%92%D1%81%D0%B5&story=%D0%92%D1%81%D0%B5&page=1', aria-current='page') 1
        a(href='?age=%D0%92%D1%81%D0%B5&story=%D0%92%D1%81%D0%B5&page=2') 2
  +siteFooter()
  button.sticky-top#toTop(aria-label='Наверх')
    svg.icon(aria-hidden='true')
      use(href='/assets/icons.svg#arrow-up')
  .toast#toast
  .modal#modal
    .modal-card
      button.modal-close#modalClose(aria-label='Закрыть')
        svg.icon(aria-hidden='true')
          use(href='/assets/icons.svg#close')
      #modalContent
