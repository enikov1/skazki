extends _layout.pug

include ../includes/site.pug

block title
  title Восстановление пароля — СказкоМир

block content
  +siteHeader('')
  main.page-wrap.auth-page
    +siteSearch()
    +breadcrumbs([{label: 'Главная', href: 'index.html'}, {label: 'Вход', href: 'login.html'}, {label: 'Восстановление пароля', href: null}])
    .auth-layout.auth-layout-compact
      +authIntro('Поможем вернуться', 'Восстановление доступа', 'Укажите адрес электронной почты, который вы использовали при регистрации.')
      section.auth-card(aria-labelledby='authTitle')
        span.auth-kicker Личный кабинет
        h2#authTitle Забыли пароль?
        p.auth-description Мы поможем восстановить доступ к вашей книжной полке.
        form#recoverForm.auth-form(action='#', method='post')
          .field
            label(for='recoverEmail') Электронная почта
            input#recoverEmail(type='email', name='email', autocomplete='email', placeholder='ваша почта', required)
          button.btn.auth-submit(type='submit') Продолжить
          p#authStatus.form-status(role='status', aria-live='polite', hidden)
        p.auth-switch Вспомнили пароль? <a href='login.html'>Вернуться ко входу</a>
  +siteFooter()
  .toast#toast

