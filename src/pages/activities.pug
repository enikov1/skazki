extends _layout.pug

include ../includes/site.pug

block title
  title Занятия и игры — СказкоМир

block content
  +siteHeader('activities')
  main.page-wrap
    +siteSearch()
    +breadcrumbs([{label: 'Главная', href: 'index.html'}, {label: 'Занятия', href: null}])
    .page-heading-art
      div
        h1.page-title Занятия и игры
        p.lead Интерактивные задания, в которых можно сразу попробовать раскрасить, найти отличия и решить задачку.
      img(src='/assets/illustrations/logic-puzzles.svg', alt='Ребёнок собирает деревянную головоломку с лесными зверятами')
    .two-col
      section.page-panel
        h2 Загадка дня
        p Без рук, без топорёнка построена избёнка. Кто в ней живёт?
        #riddleAnswers
          button.quiz-option(data-riddle='1')
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#bee')
            |  Пчёлы
          button.quiz-option(data-riddle='0')
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#bear')
            |  Медведь
          button.quiz-option(data-riddle='0')
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#squirrel')
            |  Белка
        p#riddleResult.notice(hidden)
      section.page-panel
        h2 Викторины по сказкам
        p Вспомните героев и события знакомых историй.
        p
          a.pill(href='quiz.html?id=kolobok')
            | Колобок 
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#arrow-right')
        p
          a.pill(href='quiz.html?id=repka')
            | Репка 
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#arrow-right')
        p
          a.pill(href='quiz.html?id=three-pigs')
            | Три поросёнка 
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#arrow-right')
        p
          a.pill(href='quiz.html?id=masha')
            | Маша и медведь 
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#arrow-right')
    section.page-panel
      .section-head
        h2 Три занятия
      .activity-row
        a.activity-card(href='coloring.html')
          img.activity-art(src='/assets/illustrations/coloring.svg', alt='Ребёнок рисует цветными карандашами', loading='lazy')
          span.activity-icon
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#palette')
          b Раскраски
          p Выберите цвет и раскрасьте рисунок
          span.tile-link
            | Открыть занятие 
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#arrow-right')
        a.activity-card(href='differences.html')
          img.activity-art(src='/assets/illustrations/find-differences.svg', alt='Ребёнок ищет отличия на двух картинках', loading='lazy')
          span.activity-icon
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#search')
          b Найди отличия
          p Найдите пять отличий между картинками
          span.tile-link
            | Открыть занятие 
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#arrow-right')
        a.activity-card(href='logic.html')
          img.activity-art(src='/assets/illustrations/logic-puzzles.svg', alt='Ребёнок решает деревянную головоломку', loading='lazy')
          span.activity-icon
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#puzzle')
          b Логические задачки
          p Решите задания с выбором ответа
          span.tile-link
            | Открыть занятие 
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#arrow-right')
  +siteFooter()
  button.sticky-top#toTop(aria-label='Наверх')
    svg.icon(aria-hidden='true')
      use(href='/assets/icons.svg#arrow-up')
  .toast#toast
  .modal#modal
    .modal-card
      button.modal-close#modalClose(aria-label='Закрыть')
        svg.icon(aria-hidden='true')
          use(href='/assets/icons.svg#close')
      #modalContent
