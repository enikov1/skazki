extends _layout.pug

include ../includes/site.pug

block title
  title Поиск — СказкоМир

block content
  +siteHeader('')
  main.page-wrap
    +siteSearch()
    +breadcrumbs([{label: 'Главная', href: 'index.html'}, {label: 'Поиск', href: null}])
    h1.page-title Поиск по библиотеке
    p.lead Найдите сказку по названию или автору.
    section.page-panel
      .field
        label Поисковый запрос
        input#pageSearch(placeholder='Например, Колобок')
      .filters
        button.pill.active(type='button', data-search-type='Все') Все
        button.pill(type='button', data-search-type='Сказки') Сказки
        button.pill(type='button', data-search-type='Аудио') Аудио
        button.pill(type='button', data-search-type='Стихи') Стихи
        button.pill(type='button', data-search-type='Рассказы') Рассказы
      p.catalog-count#searchCount(role='status' aria-live='polite') 12 материалов
      .catalog-grid#searchGrid
        a.book-card(href='story.html?id=kolobok', data-book-id='kolobok', data-genre='Народные', data-age='3–5 лет', data-search='колобок русская народная сказка народные')
          .cover.c1
            img.cover-img(src='/assets/covers/kolobok.svg', alt='Иллюстрация к сказке «Колобок»', loading='lazy')
            span.mini-title Колобок
          h3 Колобок
          .author Русская народная сказка
        a.book-card(href='story.html?id=repka', data-book-id='repka', data-genre='Народные', data-age='3–5 лет', data-search='репка русская народная сказка народные')
          .cover.c2
            img.cover-img(src='/assets/covers/repka.svg', alt='Иллюстрация к сказке «Репка»', loading='lazy')
            span.mini-title Репка
            span.audio-play
              svg.icon(aria-hidden='true')
                use(href='/assets/icons.svg#play')
          h3 Репка
          .author Русская народная сказка
        a.book-card(href='story.html?id=three-pigs', data-book-id='three-pigs', data-genre='Про животных', data-age='5–8 лет', data-search='три поросёнка с. михалков про животных')
          .cover.c3
            img.cover-img(src='/assets/covers/three-pigs.svg', alt='Иллюстрация к сказке «Три поросёнка»', loading='lazy')
            span.mini-title Три поросёнка
            span.audio-play
              svg.icon(aria-hidden='true')
                use(href='/assets/icons.svg#play')
          h3 Три поросёнка
          .author С. Михалков
        a.book-card(href='story.html?id=masha', data-book-id='masha', data-genre='Народные', data-age='5–8 лет', data-search='маша и медведь русская народная сказка народные')
          .cover.c4
            img.cover-img(src='/assets/covers/masha.svg', alt='Иллюстрация к сказке «Маша и медведь»', loading='lazy')
            span.mini-title Маша и медведь
            span.audio-play
              svg.icon(aria-hidden='true')
                use(href='/assets/icons.svg#play')
          h3 Маша и медведь
          .author Русская народная сказка
        a.book-card(href='story.html?id=sivka', data-book-id='sivka', data-genre='Народные', data-age='5–8 лет', data-search='сивка-бурка русская народная сказка народные')
          .cover.c5
            img.cover-img(src='/assets/covers/sivka-burka.svg', alt='Иллюстрация к сказке «Сивка-Бурка»', loading='lazy')
            span.mini-title Сивка-Бурка
            span.audio-play
              svg.icon(aria-hidden='true')
                use(href='/assets/icons.svg#play')
          h3 Сивка-Бурка
          .author Русская народная сказка
        a.book-card(href='story.html?id=little-red', data-book-id='little-red', data-genre='Авторские', data-age='5–8 лет', data-search='красная шапочка шарль перро авторские')
          .cover.c6
            img.cover-img(src='/assets/covers/red-riding-hood.svg', alt='Иллюстрация к сказке «Красная Шапочка»', loading='lazy')
            span.mini-title Красная Шапочка
            span.audio-play
              svg.icon(aria-hidden='true')
                use(href='/assets/icons.svg#play')
          h3 Красная Шапочка
          .author Шарль Перро
        a.book-card(href='story.html?id=thumbelina', data-book-id='thumbelina', data-genre='Авторские', data-age='9–12 лет', data-search='дюймовочка г. х. андерсен авторские')
          .cover.c7
            img.cover-img(src='/assets/covers/thumbelina.svg', alt='Иллюстрация к сказке «Дюймовочка»', loading='lazy')
            span.mini-title Дюймовочка
            span.audio-play
              svg.icon(aria-hidden='true')
                use(href='/assets/icons.svg#play')
          h3 Дюймовочка
          .author Г. Х. Андерсен
        a.book-card(href='story.html?id=turnip', data-book-id='turnip', data-genre='Про животных', data-age='5–8 лет', data-search='лисичка со скалочкой русская народная сказка про животных')
          .cover.c8
            img.cover-img(src='/assets/covers/fox-rolling-pin.svg', alt='Иллюстрация к сказке «Лисичка со скалочкой»', loading='lazy')
            span.mini-title Лисичка со скалочкой
            span.audio-play
              svg.icon(aria-hidden='true')
                use(href='/assets/icons.svg#play')
          h3 Лисичка со скалочкой
          .author Русская народная сказка
        a.book-card(href='story.html?id=aybolit', data-book-id='aybolit', data-genre='Стихи', data-item-type='poem', data-age='5–8 лет', data-search='доктор айболит корней чуковский стихи')
          .cover.c9
            img.cover-img(src='/assets/covers/aybolit.svg', alt='Иллюстрация к сказке «Доктор Айболит»', loading='lazy')
            span.mini-title Доктор Айболит
            span.audio-play
              svg.icon(aria-hidden='true')
                use(href='/assets/icons.svg#play')
          h3 Доктор Айболит
          .author Корней Чуковский
        a.book-card(href='story.html?id=moydodyr', data-book-id='moydodyr', data-genre='Стихи', data-item-type='poem', data-age='3–5 лет', data-search='мойдодыр корней чуковский стихи')
          .cover.c10
            img.cover-img(src='/assets/covers/moidodyr.svg', alt='Иллюстрация к сказке «Мойдодыр»', loading='lazy')
            span.mini-title Мойдодыр
            span.audio-play
              svg.icon(aria-hidden='true')
                use(href='/assets/icons.svg#play')
          h3 Мойдодыр
          .author Корней Чуковский
        a.book-card(href='story.html?id=fox-crane', data-book-id='fox-crane', data-genre='Народные', data-age='3–5 лет', data-search='лиса и журавль русская народная сказка народные')
          .cover.c11
            img.cover-img(src='/assets/covers/fox-and-crane.svg', alt='Иллюстрация к сказке «Лиса и журавль»', loading='lazy')
            span.mini-title Лиса и журавль
            span.audio-play
              svg.icon(aria-hidden='true')
                use(href='/assets/icons.svg#play')
          h3 Лиса и журавль
          .author Русская народная сказка
        a.book-card(href='story.html?id=cat-house', data-book-id='cat-house', data-genre='Стихи', data-item-type='poem', data-age='5–8 лет', data-search='кошкин дом самуил маршак стихи')
          .cover.c12
            img.cover-img(src='/assets/covers/koshkin-dom.svg', alt='Иллюстрация к сказке «Кошкин дом»', loading='lazy')
            span.mini-title Кошкин дом
            span.audio-play
              svg.icon(aria-hidden='true')
                use(href='/assets/icons.svg#play')
          h3 Кошкин дом
          .author Самуил Маршак
  +siteFooter()
  button.sticky-top#toTop(aria-label='Наверх')
    svg.icon(aria-hidden='true')
      use(href='/assets/icons.svg#arrow-up')
  .toast#toast
  .modal#modal
    .modal-card
      button.modal-close#modalClose(aria-label='Закрыть')
        svg.icon(aria-hidden='true')
          use(href='/assets/icons.svg#close')
      #modalContent
