                span.audio-play
                  svg.icon(aria-hidden='true')
                    use(href='/assets/icons.svg#play')
              h3 Репка
              .author Русская народная сказка
            a.book-card(href='story.html?id=three-pigs', data-book-id='three-pigs', data-genre='Про животных', data-age='5–8 лет', data-search='три поросёнка с. михалков про животных')
              .cover.c3
                img.cover-img(src='/assets/covers/three-pigs.jpg', alt='Иллюстрация к сказке «Три поросёнка»', loading='lazy')
                span.mini-title Три поросёнка
                span.audio-play
                  svg.icon(aria-hidden='true')
                    use(href='/assets/icons.svg#play')
              h3 Три поросёнка
              .author С. Михалков
            a.book-card(href='story.html?id=masha', data-book-id='masha', data-genre='Народные', data-age='5–8 лет', data-search='маша и медведь русская народная сказка народные')
              .cover.c4
                img.cover-img(src='/assets/covers/masha.jpg', alt='Иллюстрация к сказке «Маша и медведь»', loading='lazy')
                span.mini-title Маша и медведь
                span.audio-play
                  svg.icon(aria-hidden='true')
                    use(href='/assets/icons.svg#play')
              h3 Маша и медведь
              .author Русская народная сказка
            a.book-card(href='story.html?id=sivka', data-book-id='sivka', data-genre='Народные', data-age='5–8 лет', data-search='сивка-бурка русская народная сказка народные')
              .cover.c5
                img.cover-img(src='/assets/covers/sivka-burka.jpg', alt='Иллюстрация к сказке «Сивка-Бурка»', loading='lazy')
                span.mini-title Сивка-Бурка
                span.audio-play
                  svg.icon(aria-hidden='true')
                    use(href='/assets/icons.svg#play')
              h3 Сивка-Бурка
              .author Русская народная сказка
            a.book-card(href='story.html?id=little-red', data-book-id='little-red', data-genre='Авторские', data-age='5–8 лет', data-search='красная шапочка шарль перро авторские')
              .cover.c6
                img.cover-img(src='/assets/covers/red-riding-hood.jpg', alt='Иллюстрация к сказке «Красная Шапочка»', loading='lazy')
                span.mini-title Красная Шапочка
                span.audio-play
                  svg.icon(aria-hidden='true')
                    use(href='/assets/icons.svg#play')
              h3 Красная Шапочка
              .author Шарль Перро
        section.section
          .section-head
            h2 Занятия для детей
            a(href='activities.html') Все занятия →
          .round-row
            a.round-card(href='activities.html')
              span.round-icon
                svg.icon(aria-hidden='true')
                  use(href='/assets/icons.svg#puzzle')
              | Загадки
            a.round-card(href='activities.html')
              span.round-icon
                svg.icon(aria-hidden='true')
                  use(href='/assets/icons.svg#bulb')
              | Викторины
            a.round-card(href='coloring.html')
              span.round-icon
                svg.icon(aria-hidden='true')
                  use(href='/assets/icons.svg#palette')
              | Раскраски
            a.round-card(href='logic.html')
              span.round-icon
                svg.icon(aria-hidden='true')
                  use(href='/assets/icons.svg#target')
              | Счёт
            a.round-card(href='fairy-tales.html')
              span.round-icon
                svg.icon(aria-hidden='true')
                  use(href='/assets/icons.svg#book')
              | Чтение
      aside.sidebar
        section.sidebox
          h3
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#medal')
            |  Самые активные
          ul
            li.rank
              i 1
              | Миша
              span 985
            li.rank
              i 2
              | Алиса
              span 840
            li.rank
              i 3
              | Варвара
              span 756
            li.rank
              i 4
              | Саша
              span 691
            li.rank
              i 5
              | Марина
              span 570
        section.sidebox
          h3
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#message')
            |  Последние заметки
          .recent-notes
            article.recent-note
              .note-avatar.note-peach М
              .note-content
                p «Очень добрая сказка!»
                a(href='story.html?id=kolobok') Маша · Колобок
              +commentReactions(12, 1)
            article.recent-note
              .note-avatar.note-mint И
              .note-content
                p «Читали всей семьёй»
                a(href='story.html?id=three-pigs') Илья · Три поросёнка
              +commentReactions(8, 0)
            article.recent-note
              .note-avatar.note-lilac С
              .note-content
                p «Понравился герой»
                a(href='story.html?id=masha') Соня · Маша и медведь
              +commentReactions(6, 0)
          a.sidebox-more(href='comments.html') Все отзывы читателей →
        section.sidebox
          h3
            svg.icon(aria-hidden='true')
              use(href='/assets/icons.svg#heart')
