mixin authIntro(label, heading, description, art, artAlt)
  aside.auth-aside
    a.brand(href='index.html')
      span.brand-icon
        svg.icon(aria-hidden='true')
          use(href='/assets/icons.svg#bear')
      span
        | СказкоМир
        small ЧИТАЕМ ВМЕСТЕ
    span.auth-kicker= label
    h1= heading
    p= description
    if art
      img.auth-illustration(src=art, alt=artAlt)
    .auth-aside-note
      svg.icon(aria-hidden='true')
        use(href='/assets/icons.svg#book')
      span Уютная библиотека для всей семьи
